{
  "name": "cover-type-studio",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "本机离线封面标题设计与透明图片导出工具",
  "author": "字造",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "desktop": "electron .",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "pack:exe": "npm run build && npm run prepare:desktop && electron-builder --config desktop/builder.cjs --win portable --x64",
    "test:desktop": "node tests/desktop.mjs",
    "test:upgrade": "node tests/upgrade.mjs",
    "verify:fonts": "node scripts/prepare-fonts.mjs --verify",
    "pack:photoshop": "node scripts/package-photoshop.mjs"
  },
  "dependencies": {
    "ag-psd": "34.1.0",
    "fflate": "0.8.3",
    "fontkit": "^2.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "playwright": "^1.51.0",
    "sharp": "^0.33.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
